
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Student</title>
</head>
<body>
    <h1>Edit Student</h1>

    <form action="/students/edit/<%= student.id %>" method="POST">

        <label for="student_id">Student ID:</label>
        <input type="text" id="student_id" name="student_id"
               value="<%= student.student_id %>" required>
        <br><br>

        <label for="first_name">First Name:</label>
        <input type="text" id="first_name" name="first_name"
               value="<%= student.first_name %>" required>
        <br><br>

        <label for="last_name">Last Name:</label>
        <input type="text" id="last_name" name="last_name"
               value="<%= student.last_name %>" required>
        <br><br>

        <label for="course">Course:</label>
        <input type="text" id="course" name="course"
               value="<%= student.course %>" required>
        <br><br>

        <label for="year_level">Year Level:</label>
        <input type="number" id="year_level" name="year_level"
               value="<%= student.year_level %>" min="1" max="5" required>
        <br><br>

        <label for="email">Email:</label>
        <input type="email" id="email" name="email"
               value="<%= student.email %>" required>
        <br><br>

        <button type="submit">Save Changes</button>
        <a href="/">Cancel</a>

    </form>
</body>
</html>
